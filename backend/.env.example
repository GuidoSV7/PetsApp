# Copy to backend/.env and fill in the values. Never commit the .env file.

# Postgres connection string used by the API pool and by drizzle-kit migrate.
DATABASE_URL=postgresql://petsapp:petsapp@localhost:5432/petsapp
# SSL: "true" turns it on, "false" turns it off even when PROD=production.
DATABASE_SSL=false
# Optional CA certificate path for SSL connections.
DATABASE_SSL_CA=
# In production certificates are not verified unless this is "true".
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Empty uses 10 connections.
DB_POOL_MAX=
# Empty uses 5000 ms.
DB_CONNECTION_TIMEOUT_MS=

# Runtime environment. NODE_ENV=production or PROD=production enables the
# Secure __Host- session cookie, the 1-hop trust proxy default and database SSL.
NODE_ENV=development
PROD=
# Empty uses port 3000. 3001 avoids clashing with a local frontend dev server.
PORT=3001
# Reverse proxy hops to trust for the client IP (throttling). Empty: 1 in
# production, 0 elsewhere. Only an integer hop count is accepted.
TRUST_PROXY=

# Browser origins allowed by CORS and by the CSRF origin check, comma-separated.
# Empty outside development fails closed. CORS_ENABLED=false turns CORS off.
CORS_ORIGIN=http://localhost:3000
CORS_ENABLED=

# Required outside NODE_ENV=development. At least 32 characters
# (for example: openssl rand -base64 48).
JWT_SECRET=
# Token and session cookie lifetime. Empty uses 12h.
JWT_EXPIRES_IN=12h

# Shared secret for server-to-server calls (X-Client-Secret header). Empty
# rejects those calls, except in NODE_ENV=development.
CLIENT_SECRET=

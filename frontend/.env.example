NEXT_PUBLIC_PETSAPP_API_URL=
# Public origin for SEO, sitemap, robots, and WhatsApp/Facebook share cards (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://petsapp.io
PETSAPP_API_INTERNAL_URL=
# Same OAuth 2.0 Web client ID as backend GOOGLE_CLIENT_ID (Google Cloud Console).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Pollar publishable key — enables the Pollar home gate with working Google + Freighter.
# Without it, Freighter appears as “Próximamente” on the Nest login gate.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
